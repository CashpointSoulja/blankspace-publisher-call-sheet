{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "domains.schema.json",
  "title": "domains.json",
  "description": "Every cited registrable domain (Public Suffix List), keyed by domain, with its class and one line of rationale (SPEC §6). Only class publisher is ranked.",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "required": ["class", "rationale", "citations", "probes_cited", "vertical_shares"],
    "additionalProperties": false,
    "properties": {
      "class": { "enum": ["publisher", "retailer", "brand", "ugc", "other"] },
      "rationale": { "type": "string", "minLength": 1 },
      "citations": { "type": "integer", "minimum": 1 },
      "probes_cited": { "type": "integer", "minimum": 1 },
      "vertical_shares": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 } }
    }
  }
}
