{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agents.schema.json",
  "title": "agents.json",
  "description": "Crawler product tokens evaluated against robots.txt (SPEC §4), each checked against vendor documentation or marked unverified with a corroborating source. Shared by the site and the worker.",
  "type": "object",
  "required": ["checked_at", "agents"],
  "additionalProperties": false,
  "properties": {
    "checked_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "note": { "type": "string" },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["token", "group", "vendor", "verified", "doc_url", "date_checked"],
        "additionalProperties": false,
        "properties": {
          "token": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "description": "robots.txt product token, matched case-insensitively." },
          "group": { "enum": ["training", "search_user_triggered", "ads"], "description": "ads tokens are reported per agent but count towards neither the training nor the search status." },
          "vendor": { "type": "string" },
          "verified": { "type": "boolean", "description": "true when the token was confirmed on doc_url." },
          "doc_url": { "type": ["string", "null"], "pattern": "^https://" },
          "date_checked": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "note": { "type": "string" },
          "corroboration_url": { "type": "string", "pattern": "^https://", "description": "Required when verified is false." }
        }
      }
    }
  }
}
