{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "queries.schema.json",
  "title": "queries.json",
  "description": "The buyer-intent queries probed in the sample (SPEC §6), recorded exactly as sent.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "vertical", "q"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^(auto|ce|sport)-\\d{2}$" },
      "vertical": { "enum": ["automotive", "consumer_electronics", "sportswear"] },
      "q": { "type": "string", "minLength": 1 }
    }
  }
}
