{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sample.schema.json",
  "title": "sample.json",
  "description": "Metadata for the dated citation sample: conditions, counts, class shares and cost. The front page and /method/ read their numbers from here.",
  "type": "object",
  "required": ["sample_id", "dates_utc", "engines", "runs_per_query", "queries", "probes", "condition", "total_citations", "unique_domains", "publishers_cited", "citation_buckets", "signal_definition"],
  "additionalProperties": false,
  "properties": {
    "sample_id": { "type": "string", "pattern": "^[a-z]+-\\d{4}-\\d{2}-\\d{2}$" },
    "dates_utc": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" } },
    "engines": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "runs_per_query": { "type": "integer", "minimum": 1 },
    "queries": { "type": "integer", "minimum": 1 },
    "probes": { "type": "integer", "minimum": 1, "description": "queries × engines × runs" },
    "condition": { "type": "string", "description": "Shown verbatim on /method/." },
    "total_citations": { "type": "integer", "minimum": 0, "description": "Rows in citation-sample.csv with a cited URL." },
    "unique_domains": { "type": "integer", "minimum": 0, "description": "Entries in domains.json." },
    "publishers_cited": { "type": "integer", "minimum": 0, "description": "Publisher-class entries in domains.json; rows in readership.json." },
    "citation_buckets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class", "share", "count"],
        "additionalProperties": false,
        "properties": {
          "class": { "enum": ["publisher", "retailer", "brand", "ugc", "other"] },
          "share": { "type": "number", "minimum": 0, "maximum": 1 },
          "count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "collection_cost_usd": { "type": "number", "minimum": 0, "description": "Sum of per-probe cost_usd in raw/probes.jsonl." },
    "total_spend_usd_exact": { "type": "number", "minimum": 0 },
    "signal_definition": { "type": "string", "description": "What citation share is and is not. Shown verbatim on /method/." }
  }
}
