{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "corrections.schema.json",
  "title": "corrections.json",
  "description": "Dated corrections to the sample's classification, applied at load time. The collected files are never edited.",
  "type": "object",
  "required": ["corrections"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "corrections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["domain", "field", "from", "to", "rationale", "reason", "sources"],
        "additionalProperties": false,
        "properties": {
          "domain": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$" },
          "field": { "const": "class" },
          "from": { "enum": ["publisher", "retailer", "brand", "ugc", "other"] },
          "to": { "enum": ["publisher", "retailer", "brand", "ugc", "other"] },
          "rationale": { "type": "string", "minLength": 1, "description": "The corrected one-line rationale." },
          "reason": { "type": "string", "minLength": 1 },
          "sources": { "$ref": "#/$defs/sources" }
        }
      }
    }
  },
  "$defs": {
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["url", "accessed", "finding"], "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "pattern": "^https://" },
          "accessed": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "finding": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
