{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "front.schema.json",
  "title": "front.json",
  "description": "Front-page fields that are not sample data. Sample figures come from sample.json and readership.json, so they exist in one place only.",
  "type": "object",
  "required": ["builder", "verifier_example"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "verifier_example": {
      "type": ["object", "null"],
      "required": ["domain", "removed_text", "reason"],
      "additionalProperties": false,
      "properties": {
        "domain": { "type": "string" },
        "removed_text": { "type": "string", "description": "Verbatim sentence the verifier removed. Must appear in verifier/{domain}.json." },
        "reason": { "enum": ["no_matching_evidence", "value_mismatch", "unmarked_factual_sentence", "company_claim_misphrased"] }
      }
    },
    "builder": {
      "type": "object",
      "required": ["name", "bio", "repo_url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "bio": { "type": ["string", "null"] },
        "repo_url": { "type": ["string", "null"], "pattern": "^https://" }
      }
    }
  }
}
