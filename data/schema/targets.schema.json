{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "targets.schema.json",
  "title": "targets.json",
  "description": "Ranked call sheet (SPEC §8.2). Sub-scores are normalised to [0, 1]; null means unknown and is excluded from both total and max.",
  "type": "object",
  "required": ["sample_id", "generated_at", "default_weights", "rows"],
  "additionalProperties": false,
  "$defs": {
    "sub": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
  },
  "properties": {
    "$schema": { "type": "string" },
    "$comment": { "type": "string" },
    "sample_id": { "type": ["string", "null"], "pattern": "^cs-\\d{4}-\\d{2}-\\d{2}$" },
    "generated_at": { "type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}T", "description": "ISO-8601 timestamp of the scoring run." },
    "default_weights": {
      "type": "object",
      "required": ["readership", "placement", "programmatic", "reachability", "commerce"],
      "additionalProperties": false,
      "properties": {
        "readership": { "type": "number", "minimum": 0 },
        "placement": { "type": "number", "minimum": 0 },
        "programmatic": { "type": "number", "minimum": 0 },
        "reachability": { "type": "number", "minimum": 0 },
        "commerce": { "type": "number", "minimum": 0 }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "domain", "vertical", "subscores", "total", "max", "stance", "stability", "cdn"],
        "additionalProperties": false,
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "domain": { "type": "string", "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$", "description": "Registrable domain. Must have data/evidence/{domain}.json." },
          "vertical": { "enum": ["automotive", "consumer_electronics", "sportswear"] },
          "subscores": {
            "type": "object",
            "required": ["readership", "placement", "programmatic", "reachability", "commerce"],
            "additionalProperties": false,
            "properties": {
              "readership": { "$ref": "#/$defs/sub" },
              "placement": { "$ref": "#/$defs/sub" },
              "programmatic": { "$ref": "#/$defs/sub" },
              "reachability": { "$ref": "#/$defs/sub" },
              "commerce": { "$ref": "#/$defs/sub" }
            }
          },
          "total": { "type": "number", "minimum": 0, "maximum": 100 },
          "max": { "type": "number", "minimum": 0, "maximum": 100 },
          "stance": { "enum": ["already-decided", "reading-free", "no-owner", "closed-door", "unknown"] },
          "stability": { "enum": ["both_runs", "one_run", "single_run_only"] },
          "cdn": { "type": "array", "items": { "enum": ["cloudflare", "fastly", "cloudfront", "akamai", "vercel", "unidentified"] } }
        }
      }
    }
  }
}
